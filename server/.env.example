# Copy this file to .env and fill in real values. Never commit or share .env.

# Supabase → your project → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

PORT=5000

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWTPRIVATEKEY=change-me

SALT=10
