# Copy this file to .env and fill in real values. Never commit or share .env.

# Supabase -> your project -> Connect -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password (no square brackets).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Secret used to sign logins. Must be long and random (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWTPRIVATEKEY=change-me

PORT=5000

# --- Optional ---
# How long a login lasts before staff must log in again (default 12h).
# TOKEN_TTL=12h
# Only needed if the app is served from a different web address than the server.
# CORS_ORIGIN=https://pos.example.com
# Set to 1 when running behind a hosting platform's proxy (Render, Railway, etc.).
# TRUST_PROXY=1

# --- Running this for ONE shop of your own (instead of the MecQuad client platform) ---
# Set SHOP_NAME and the shop, its branches and owner login are created the first time
# the server starts. Afterwards these are ignored, so a restart never changes live data.
# The client portal (/platform) is switched off while SHOP_NAME is set.
# SHOP_NAME=Idealz Lanka
# SHOP_TYPE=electronics            # electronics | grocery | general
# BRANCHES=Colombo 03,Kandy,Galle  # shops that sell
# WAREHOUSES=Main warehouse        # stock only, cannot sell
# OWNER_NAME=Shakeeb Ahamed
# OWNER_EMAIL=you@mecquad.tech
# OWNER_PASSWORD=                  # 8+ characters, with capitals, small letters and numbers
# SHOP_PHONE=
# SHOP_ADDRESS=
# SHOP_CURRENCY=Rs.
# SHOP_TIMEZONE=Asia/Colombo
# RECEIPT_FOOTER=Keep this receipt for warranty claims.
# ENABLE_PLATFORM=1                # only if you also want the client portal here

# Database security: auto (default) | require | off.
# "auto" uses SSL for databases reached over the internet (Supabase, Neon) and not for
# ones on this machine or the host's private network (Railway, Fly).
# DB_SSL=auto
