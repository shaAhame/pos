# Copy this file to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
PORT=5000
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWTPRIVATEKEY=change-me
SALT=10
